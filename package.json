{
  "name": "omp-zcode-provider",
  "version": "0.6.0",
  "description": "Use the ZCode agent (zcodex app-server) as an omp model provider: omp is the chat frontend, ZCode runs the model and its own tools (bash, edits, session memory). Fork of zcode-provider.",
  "keywords": [
    "omp-package",
    "omp-extension",
    "zcode",
    "opencode",
    "agent"
  ],
  "license": "MIT",
  "type": "module",
  "private": false,
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizquuula/omp-zcode-provider.git"
  },
  "homepage": "https://github.com/rizquuula/omp-zcode-provider",
  "bugs": {
    "url": "https://github.com/rizquuula/omp-zcode-provider/issues"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-tui": {
      "optional": true
    }
  },
  "omp": {
    "extensions": [
      "./extensions"
    ]
  }
}
